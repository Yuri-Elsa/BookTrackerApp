<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rak Bacaan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container site-header__inner">
            <a class="site-brand" asp-controller="Book" asp-action="Index">
                <span class="site-brand__mark">&#128218;</span>
                <span class="site-brand__text">Rak Bacaan</span>
            </a>
            <nav class="site-nav">
                <a asp-controller="Book" asp-action="Index">Koleksi</a>
                <a asp-controller="Book" asp-action="Create">Tambah Buku</a>
            </nav>
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <span>&copy; 2026 Rak Bacaan &mdash; catatan buku pribadi</span>
            <a asp-controller="Home" asp-action="Privacy">Privasi</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
