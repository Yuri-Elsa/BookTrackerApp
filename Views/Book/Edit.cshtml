@model BookTrackerApp.Models.Book

@{
    ViewData["Title"] = "Edit Buku";
}

<div class="container">
    <div class="shelf-hero">
        <p class="shelf-hero__eyebrow">Ubah detail</p>
        <h1>Edit Buku</h1>
        <p>Perbarui informasi buku ini di rak kamu.</p>
    </div>

    <div class="shelf-form-layout">
        <div class="shelf-form-card">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-3">
                    <label asp-for="Title" class="control-label">Judul</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Author" class="control-label">Penulis</label>
                    <input asp-for="Author" class="form-control" />
                    <span asp-validation-for="Author" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Price" class="control-label">Harga</label>
                    <input asp-for="Price" class="form-control" step="any" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                    <small class="text-muted">Gunakan titik untuk desimal, contoh: 15000.50</small>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsRead" class="form-check-input" />
                    <label asp-for="IsRead" class="form-check-label">Sudah Dibaca</label>
                </div>

                <div class="form-group d-flex gap-2">
                    <button type="submit" class="btn-shelf-primary">Simpan Perubahan</button>
                    <a asp-action="Index" class="btn-shelf-outline">Batal</a>
                </div>
            </form>
        </div>

        <aside class="shelf-preview">
            <p class="shelf-preview__label">Pratinjau Kartu</p>
            <div class="book-card" style="--spine-color: var(--gold-dark)">
                <p class="book-card__title" id="previewTitle">@Model.Title</p>
                <p class="book-card__author" id="previewAuthor">@Model.Author</p>
                <div class="book-card__meta">
                    <span class="book-card__price" id="previewPrice">Rp @Model.Price.ToString("N0")</span>
                    <span class="badge-status @(Model.IsRead ? "badge-status--read" : "badge-status--unread")" id="previewBadge">@(Model.IsRead ? "Selesai Dibaca" : "Belum Dibaca")</span>
                </div>
            </div>
            <p class="shelf-preview__hint">Kartu ini otomatis berubah sesuai isian form di sebelah kiri.</p>
        </aside>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
