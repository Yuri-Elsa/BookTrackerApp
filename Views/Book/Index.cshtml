@model IEnumerable<BookTrackerApp.Models.Book>

@{
    ViewData["Title"] = "Koleksi Buku";

    var books = Model.ToList();
    var totalBooks = books.Count;
    var readCount = books.Count(b => b.IsRead);
    var unreadCount = totalBooks - readCount;
    var totalValue = books.Sum(b => b.Price);

    // Warna "punggung buku" yang dipilih dari satu palet hangat yang senada,
    // supaya rak terlihat beragam tapi tetap harmonis.
    string[] spineColors = { "#B8863B", "#3F5B4B", "#8A3B3B", "#5B6B8C", "#6B5D4E" };

    string SpineColorFor(string title)
    {
        int hash = 0;
        foreach (var c in title)
        {
            hash = (hash * 31 + c) & 0x7fffffff;
        }
        return spineColors[hash % spineColors.Length];
    }
}

<div class="container">
    <div class="shelf-hero">
        <p class="shelf-hero__eyebrow">Koleksi pribadi</p>
        <h1>Rak Bacaan Saya</h1>
        <p>Catat buku yang kamu punya, pantau mana yang sudah kelar dibaca, dan lihat berapa yang sudah kamu habiskan untuk koleksi ini.</p>
    </div>

    <div class="shelf-stats">
        <div class="shelf-stat">
            <div class="shelf-stat__value">@totalBooks</div>
            <div class="shelf-stat__label">Total Buku</div>
        </div>
        <div class="shelf-stat">
            <div class="shelf-stat__value">@readCount</div>
            <div class="shelf-stat__label">Selesai Dibaca</div>
        </div>
        <div class="shelf-stat">
            <div class="shelf-stat__value">@unreadCount</div>
            <div class="shelf-stat__label">Belum Dibaca</div>
        </div>
        <div class="shelf-stat">
            <div class="shelf-stat__value">Rp @totalValue.ToString("N0")</div>
            <div class="shelf-stat__label">Nilai Koleksi</div>
        </div>
    </div>

    <div class="shelf-toolbar">
        <h2 class="h4 mb-0">Semua Buku</h2>
        <a asp-controller="Book" asp-action="Create" class="btn-shelf-primary">+ Tambah Buku Baru</a>
    </div>

    @if (totalBooks == 0)
    {
        <div class="shelf-empty">
            <h3>Rak kamu masih kosong</h3>
            <p>Belum ada buku yang dicatat. Tambahkan buku pertamamu untuk mulai melacak bacaan.</p>
            <a asp-controller="Book" asp-action="Create" class="btn-shelf-primary">+ Tambah Buku Baru</a>
        </div>
    }
    else
    {
        <div class="shelf-grid">
            @foreach (var book in books)
            {
                <div class="book-card" style="--spine-color: @SpineColorFor(book.Title)">
                    <p class="book-card__title">@book.Title</p>
                    <p class="book-card__author">@book.Author</p>
                    <div class="book-card__meta">
                        <span class="book-card__price">Rp @book.Price.ToString("N0")</span>
                        @if (book.IsRead)
                        {
                            <span class="badge-status badge-status--read">Selesai Dibaca</span>
                        }
                        else
                        {
                            <span class="badge-status badge-status--unread">Belum Dibaca</span>
                        }
                    </div>
                    <div class="book-card__actions">
                        <a asp-controller="Book" asp-action="Edit" asp-route-id="@book.Id" class="btn-shelf-outline">Edit</a>
                        <a asp-controller="Book" asp-action="Delete" asp-route-id="@book.Id" class="btn-shelf-danger">Hapus</a>
                        <form asp-controller="Book" asp-action="ToggleRead" asp-route-id="@book.Id" method="post">
                            <button type="submit" class="btn-shelf-outline">
                                @(book.IsRead ? "Tandai Belum" : "Tandai Selesai")
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
